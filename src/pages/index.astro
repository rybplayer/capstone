---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import SectionWithList from '@/components/SectionWithList.astro'
import { Badge } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import { ICON_MAP, SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { cardVariants } from '@/lib/card-variants'
import { getRecentPosts, getRecentProjects } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import type { SocialLink } from '@/types'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import profilePicture from '../../public/static/profile_picture.webp'

const blog = await getRecentPosts(SITE.featuredPostCount)
const projects = await getRecentProjects(SITE.featuredProjectCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section>
    <div
      class={cn(
        cardVariants({ variant: 'default', hover: 'disabled' }),
        'xs:flex-row flex flex-col gap-x-6',
      )}
    >
      <!-- Mobile layout: Profile pic with name and email -->
      <div class="xs:hidden flex gap-6">
        <div class="w-1/3 min-w-1/3">
          <Image
            src={profilePicture}
            alt="Profile Picture"
            class="rounded-lg"
            widths={[128, 256, 512, 1024]}
            loading="lazy"
            fetchpriority="high"
          />
        </div>
        <div class="flex flex-col">
          <h3 class="text-3xl font-semibold">Hi, I'm Ryan!</h3>
          <p class="text-secondary-foreground text-medium">
            rbatubara at ucsd.edu
          </p>
        </div>
      </div>

      <!-- Desktop layout: Profile picture -->
      <div class="xs:flex hidden w-1/3 flex-shrink-0">
        <Image
          src={profilePicture}
          alt="Profile Picture"
          class="rounded-lg object-cover"
          widths={[256, 512]}
          loading="lazy"
          fetchpriority="high"
        />
      </div>

      <!-- Content section -->
      <div class="flex w-full flex-col justify-between">
        <!-- Desktop layout: Name and email -->
        <div
          class="xs:flex hidden flex-wrap items-baseline justify-between gap-x-4"
        >
          <h3 class="text-4xl font-semibold">Hi, I'm Ryan!</h3>
          <p class="text-secondary-foreground text-medium">
            rbatubara at ucsd.edu
          </p>
        </div>
        <!-- Description -->
        <p
          class="text-muted-foreground text-medium py-4 break-words hyphens-auto"
        >
          I'm a <Link
            href="https://math.ucsd.edu/students/undergraduate/ma30-math-computer-science-b-s/"
            external
            underline>Math-CS</Link
          > and <Link href="https://datascience.ucsd.edu/" external underline
            >Data Science</Link
          > undergraduate at <Link href="https://ucsd.edu/" external underline
            >UCSD</Link
          >. I'm applying to MS/PhD programs in Computer Science, specifically
          in <Link
            href="https://dandu.dev/docs/quantum-type-theory.pdf"
            external
            underline>Quantum Computing</Link
          >. My other research interests include <Link
            href="https://arxiv.org/pdf/2502.12428"
            external
            underline>GPU-based computational algebra</Link
          > and <Link
            href="https://github.com/rybplayer/Talks"
            external
            underline>recreational math</Link
          >.
        </p>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-2">
          <Badge
            variant="link"
            link="https://github.com/rybplayer/Resume/blob/main/RyanBatubaraResume.pdf"
          >
            {'Resume'}
          </Badge>
          {
            SOCIAL_LINKS.map(({ href, label }: SocialLink) => (
              <Link
                href={href}
                aria-label={label}
                title={label}
                class={buttonVariants({ variant: 'outline', size: 'icon' })}
                external
              >
                <Icon
                  name={
                    ICON_MAP[label as keyof typeof ICON_MAP] ||
                    'lucide:message-circle-question'
                  }
                  class="hover:bg-secondary size-5"
                />
              </Link>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- <SectionWithList heading="News" buttonText="" buttonPath="/projects">
    <li>Research</li>
  </SectionWithList> -->

  <SectionWithList
    heading="Latest project"
    buttonText="See all projects"
    buttonPath="/projects"
  >
    {
      projects.map((project) => (
        <li>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </SectionWithList>

  <SectionWithList
    heading="Latest blog post"
    buttonText="See all posts"
    buttonPath="/blog"
  >
    {
      blog.map((post, index) => (
        <li>
          <BlogCard entry={post} isFirst={index === 0} />
        </li>
      ))
    }
  </SectionWithList>
</Layout>
