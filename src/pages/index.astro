---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { Badge } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import { ICON_MAP, SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import type { SocialLink } from '@/types'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import profilePicture from '../../public/static/profile_picture.png'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section>
    <div class="xs:flex-row flex flex-col gap-x-6 rounded-lg border p-6">
      <!-- Mobile layout: Profile pic with name and email -->
      <div class="xs:hidden flex gap-6">
        <div class="w-1/3 min-w-1/3">
          <Image
            src={profilePicture}
            alt="Profile Picture"
            class="rounded-lg"
            loading="lazy"
            fetchpriority="high"
          />
        </div>
        <div class="flex flex-col">
          <h3 class="text-3xl font-semibold">Hi, I'm Ryan.</h3>
          <a
            href="mailto:rbatubara@ucsd.edu"
            class="text-foreground text-medium transition-colors"
          >
            rbatubara at ucsd.edu
          </a>
        </div>
      </div>

      <!-- Desktop layout: Profile picture -->
      <div class="xs:flex hidden w-1/3 flex-shrink-0">
        <Image
          src={profilePicture}
          alt="Profile Picture"
          class="aspect-square rounded-lg object-cover"
          loading="lazy"
          fetchpriority="high"
        />
      </div>

      <!-- Content section -->
      <div class="flex w-full flex-col justify-between">
        <!-- Desktop layout: Name and email -->
        <div
          class="xs:flex hidden flex-wrap items-baseline justify-between gap-x-4"
        >
          <h3 class="text-3xl font-semibold">Hi, I'm Ryan.</h3>
          <a
            href="mailto:rbatubara@ucsd.edu"
            class="text-muted-foreground hover:text-foreground text-medium transition-colors"
          >
            rbatubara at ucsd.edu
          </a>
        </div>
        <!-- Description -->
        <p class="text-muted-foreground py-4 text-sm">
          I'm a <Link
            href="https://math.ucsd.edu/students/undergraduate/ma30-math-computer-science-b-s/"
            class="text-foreground"
            external
            underline>Math-CS</Link
          > and <Link
            href="https://datascience.ucsd.edu/"
            class="text-foreground"
            external
            underline>Data Science</Link
          > undergraduate at <Link
            href="https://ucsd.edu/"
            class="text-foreground"
            external
            underline>UCSD</Link
          >. I'm applying to MS/PhD programs in Computer Science, particularly
          in <Link
            href="https://dandu.dev/docs/quantum-type-theory.pdf"
            class="text-foreground"
            external
            underline>Quantum Computing</Link
          >. My other research interests include <Link
            href="https://arxiv.org/pdf/2502.12428"
            class="text-foreground"
            external
            underline>GPU-based computational algebra</Link
          > and <Link
            href="https://github.com/rybplayer/Talks"
            class="text-foreground"
            external
            underline>recreational math</Link
          >.
        </p>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-2">
          <Badge
            variant="link"
            link="https://github.com/rybplayer/Resume/blob/main/RyanBatubaraResume.pdf"
            className="flex items-center gap-x-1"
          >
            {'Resume'}
          </Badge>
          {
            SOCIAL_LINKS.map(({ href, label }: SocialLink) => (
              <Link
                href={href}
                aria-label={label}
                title={label}
                class={buttonVariants({ variant: 'link', size: 'icon' })}
                external
              >
                <Icon
                  name={
                    ICON_MAP[label as keyof typeof ICON_MAP] ||
                    'lucide:message-circle-question'
                  }
                  class="size-5"
                />
              </Link>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <div class="flex justify-between">
      <h2 class="text-2xl font-medium">Latest blog post</h2>
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>

    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post, index) => (
          <li>
            <BlogCard entry={post} isFirst={index === 0} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
