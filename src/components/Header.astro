---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import { NAV_LINKS, SITE } from '@/consts'
import { Image } from 'astro:assets'
import logoBlack from '../../public/static/logo-black.svg'
---

<header transition:persist>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 pt-4 pb-2"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-4">
      <!-- Header logo -->
      <Image
        src={logoBlack}
        alt="Logo"
        class="h-8 w-auto sm:h-10 dark:invert"
        style="aspect-ratio: 237/286;"
      />
      <!-- Header title -->
      <span class="hidden h-full text-lg font-medium min-[300px]:block"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center sm:gap-4">
      <nav class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <MobileMenu client:load transition:persist />
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>
