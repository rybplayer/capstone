---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { SITE } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'
---

<header transition:persist>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-6 px-4 pt-4 pb-2"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-4">
      <!-- Header logo -->
      <Image
        src={logo}
        alt="Logo"
        class="h-8 w-auto sm:h-10"
        style="aspect-ratio: 237/286;"
      />
      <!-- Header title -->
      <span class="hidden h-full text-xl font-semibold min-[350px]:block"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center sm:gap-4">
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>
