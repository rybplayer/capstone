---
import Link from '@/components/Link.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
---

<header transition:persist>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 pt-4 pb-2">
    <div class="flex items-center justify-between gap-4">
      <Link href="/" class="flex shrink-0 items-center justify-center gap-4">
        <Image
          src={logo}
          alt="Logo"
          class="h-8 w-auto sm:h-10"
          style="aspect-ratio: 237/286;"
        />
        <span class="hidden h-full text-xl font-semibold min-[600px]:block"
          >{SITE.title}</span
        >
      </Link>
      <div class="flex items-center gap-1 md:gap-3">
        <MobileMenu client:load />
        <ThemeToggle transition:persist />
      </div>
    </div>
    <nav class="hidden overflow-x-auto md:block">
      <ul class="flex min-w-max items-center gap-2 text-sm">
        {
          NAV_LINKS.map((item) => {
            const isActive =
              pathname === item.href ||
              (item.href !== '/' && pathname.startsWith(item.href))
            return (
              <li>
                <Link
                  href={item.href}
                  class:list={[
                    'rounded-md px-3 py-1.5 transition-colors',
                    isActive
                      ? 'bg-accent text-foreground font-medium'
                      : 'text-muted-foreground hover:bg-accent/60 hover:text-foreground',
                  ]}
                >
                  {item.label}
                </Link>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</header>
