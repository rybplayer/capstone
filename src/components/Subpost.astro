---
import { Icon } from 'astro-icon/components'

export interface Props {
  post: string
  href: string
  nav: string
  icon?: string
  desc?: string
}

const { post, href, nav, icon = 'lucide:file-text', desc = '' } = Astro.props
---

<div class="not-prose group mt-6 flex justify-center">
  <a
    href={href}
    class="hover:bg-muted inline-flex w-full items-center justify-between rounded-lg border p-3 no-underline transition-colors duration-200"
  >
    <div class="flex items-center gap-2">
      <Icon name={icon} class="size-4 flex-shrink-0" />
      <div class="flex flex-col">
        {nav && <div class="text-muted-foreground text-xs">{nav}</div>}
        <div class="font-medium">
          {post}
          {
            desc && (
              <span class="text-muted-foreground block text-xs md:ml-2 md:inline">
                {desc}
              </span>
            )
          }
        </div>
      </div>
    </div>
    <Icon
      name="lucide:arrow-right"
      class="size-4 transition-transform duration-200 group-hover:translate-x-1"
    />
  </a>
</div>
