---
import { calloutConfig, type CalloutVariant } from '@/lib/callout-config'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { cva, type VariantProps } from 'class-variance-authority'

const calloutVariants = cva(
  'relative px-4 py-3 my-6 border-l-4 text-sm scroll-mt-40',
  {
    variants: {
      variant: Object.fromEntries(
        Object.entries(calloutConfig).map(([key, config]) => [
          key,
          config.style,
        ]),
      ),
    },
    defaultVariants: {
      variant: 'note',
    },
  },
)

interface Props extends VariantProps<typeof calloutVariants> {
  title?: string
  class?: string
  variant?: CalloutVariant
  defaultOpen?: boolean
  id?: string
  tag?: boolean
}

function slugify(str: string) {
  return str
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-')
}

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

const {
  title,
  variant = 'note',
  defaultOpen = true,
  id,
  tag = false,
  ...rest
} = Astro.props
const derivedId = id ?? (title ? slugify(title) : undefined)
const config = calloutConfig[variant]
---

{
  tag ? (
    <span
      class={cn(
        'inline-flex items-center gap-1.5 border-l-4 px-2 py-1 text-sm',
        config.style,
        config.textColor,
        rest.class,
      )}
    >
      <Icon name={config.icon} class="size-4" />
      {title ?? capitalize(variant)}
    </span>
  ) : (
    <details
      id={derivedId}
      class={cn(
        calloutVariants({ variant }),
        rest.class,
        '[&[open]>summary]:mb-3 [&[open]>summary_svg:last-child]:rotate-180',
      )}
      {...rest}
      open={defaultOpen}
    >
      <summary class="flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden">
        <Icon
          name={config.icon}
          class={cn('mr-2 size-4 shrink-0', config.textColor)}
        />
        <span class={cn('mr-2 font-medium', config.textColor)}>
          {title && <span class="font-medium"> {title}</span>}
        </span>
        <Icon
          name="lucide:chevron-down"
          class={cn(
            'ml-auto h-4 w-4 shrink-0 transition-transform duration-200',
            config.textColor,
          )}
        />
      </summary>
      <div>
        <slot />
      </div>
    </details>
  )
}
