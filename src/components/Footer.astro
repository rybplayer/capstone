---
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer class="py-4">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center justify-center gap-y-2 px-4 sm:flex-row sm:justify-between"
  >
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
      <span class="text-muted-foreground text-sm">
        &copy; {new Date().getFullYear()} All rights reserved.
      </span>
      <Separator orientation="vertical" className="hidden h-4! sm:block" />
      <p class="text-muted-foreground text-sm">
        <Link
          href="https://ryanbatubara.dev"
          class="text-muted-foreground no-underline"
          external
          underline
        >
          Made by Ryan Batubara.
        </Link>
      </p>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
  <div class="flex flex-wrap items-center justify-center gap-x-2">
    <a
      href="https://kytrinh.me/gathering/ryanbatubara/previous"
      class="text-muted-foreground transition-colors hover:text-foreground"
    >
      &larr;
    </a>
    <a
      href="https://kytrinh.me/gathering"
      class="text-muted-foreground transition-colors hover:text-foreground italic"
    >
      gathering
    </a>
    <a
      href="https://kytrinh.me/gathering/ryanbatubara/next"
      class="text-muted-foreground transition-colors hover:text-foreground"
    >
      &rarr;
    </a>
  </div>
</footer>
