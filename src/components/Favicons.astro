---
import { withBase } from '@/lib/utils'
---

<link
  rel="icon"
  type="image/png"
  href={withBase('/favicon-96x96.webp')}
  sizes="96x96"
/>
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="shortcut icon" href={withBase('/favicon.ico')} />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={withBase('/apple-touch-icon.webp')}
/>
<meta name="apple-mobile-web-app-title" content="astro-erudite" />
<link rel="manifest" href={withBase('/site.webmanifest')} />
