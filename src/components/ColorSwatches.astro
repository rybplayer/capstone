---
import { colors, type ColorName, type Theme } from '@/lib/colors'

interface Props {
  theme: Theme
}

const { theme } = Astro.props
const themeColors = colors[theme]
const colorNames = Object.keys(themeColors) as ColorName[]
const bgColor = themeColors.background
const textColor = themeColors.foreground
---

<div
  class="rounded-lg border p-4"
  style={`background: ${bgColor}; color: ${textColor}; borderColor: ${textColor}`}
>
  <div class="xs:grid-cols-2 xs:grid-cols-3 grid gap-4 md:grid-cols-4">
    {
      colorNames.map((name) => (
        <div class="flex flex-col gap-1">
          <div
            class="aspect-[4/1] rounded"
            style={`background: ${themeColors[name]};`}
          />
          <span class="text-sm font-medium">{name}</span>
          <span class="font-mono text-[0.6rem] leading-none opacity-70">
            {themeColors[name]}
          </span>
        </div>
      ))
    }
  </div>
</div>
